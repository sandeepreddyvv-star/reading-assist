{
  "name": "reading-assist",
  "version": "0.1.0",
  "description": "Chrome extension that makes web pages easier to read for people with dyslexia, ADHD and other reading difficulties",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@types/chrome": "^0.3.6",
    "esbuild": "^0.28.2",
    "open-dyslexic": "^1.0.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  },
  "private": true
}
